{
  "name": "activity-shield",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Учебное расширение приватности для Chromium и Firefox",
  "scripts": {
    "release:check": "node scripts/check-release.mjs",
    "build": "node scripts/build.mjs",
    "pack": "npm run build && node scripts/package.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "android:run": "npm run build && node scripts/android-run.mjs",
    "android:lint": "web-ext lint --source-dir dist/firefox-android --self-hosted",
    "test:android": "npm run build && node --test tests/android.test.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/android-target.test.mjs tests/settings.test.mjs tests/browsers.test.mjs tests/viewport.test.mjs",
    "test:viewport": "npm run build && node --test tests/viewport.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "selenium-webdriver": "4.35.0",
    "web-ext": "10.8.0"
  }
}
